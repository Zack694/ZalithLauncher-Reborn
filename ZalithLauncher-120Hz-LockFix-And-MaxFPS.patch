diff --git a/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/utils/platform/MemoryUtils.kt b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/utils/platform/MemoryUtils.kt
--- a/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/utils/platform/MemoryUtils.kt
+++ b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/utils/platform/MemoryUtils.kt
@@ -5,27 +5,36 @@ import android.content.Context
 import android.content.Context.ACTIVITY_SERVICE
 
 object MemoryUtils {
-    private fun Context.getMemoryInfo(): ActivityManager.MemoryInfo {
-        val activityManager = getSystemService(ACTIVITY_SERVICE) as ActivityManager
-        val memInfo = ActivityManager.MemoryInfo()
-        activityManager.getMemoryInfo(memInfo)
-        return memInfo
+    @Volatile
+    private var cachedTotalMemory: Long = -1L
+    private val reusableMemInfo = ActivityManager.MemoryInfo()
+
+    private fun updateMemoryInfo(context: Context): ActivityManager.MemoryInfo {
+        val activityManager = context.getSystemService(ACTIVITY_SERVICE) as ActivityManager
+        synchronized(reusableMemInfo) {
+            activityManager.getMemoryInfo(reusableMemInfo)
+            if (cachedTotalMemory <= 0L) {
+                cachedTotalMemory = reusableMemInfo.totalMem
+            }
+            return reusableMemInfo
+        }
     }
 
     @JvmStatic
     fun getTotalDeviceMemory(context: Context): Long {
-        return context.getMemoryInfo().totalMem
+        if (cachedTotalMemory > 0L) return cachedTotalMemory
+        return updateMemoryInfo(context).totalMem
     }
 
     @JvmStatic
     fun getUsedDeviceMemory(context: Context): Long {
-        val memInfo = context.getMemoryInfo()
-        return memInfo.totalMem - memInfo.availMem
+        val info = updateMemoryInfo(context)
+        return info.totalMem - info.availMem
     }
 
     @JvmStatic
     fun getFreeDeviceMemory(context: Context): Long {
-        return context.getMemoryInfo().availMem
+        return updateMemoryInfo(context).availMem
     }
 }
